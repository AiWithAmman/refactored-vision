# Meta Model API key (claim the hackathon credits first). Never commit the real .env.
MODEL_API_KEY=your-key-here

# 1 = canned answers, no key needed. Set to 0 to call the real Meta models.
LUMEN_MOCK=1

# Standard tier only. The "-contributor" models may train on user photos.
SPARK_MODEL=muse-spark-1.3

LUMEN_DB=data/lumen.db